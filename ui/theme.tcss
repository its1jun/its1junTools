/* 전체 흰색 / 검정 배경. 이중선(double) 테두리는 제목 박스에만 사용 */

/* 스크롤바는 어디서도 보이지 않게 (스크롤은 키보드 포커스 이동으로) */
* {
    scrollbar-size: 0 0;
}

Screen {
    background: black;
    color: white;
}

#main-panel {
    width: 64;
    height: auto;
    margin-top: 1;
    padding: 0 2;
    background: black;
}

/* 제목: 두 줄 박스 */
#title-bar {
    width: 1fr;
    height: 3;
    content-align: center middle;
    color: white;
    border: double white;
    margin-bottom: 1;
}

/* ---------------- 필드 ---------------- */
/* 도구 화면: 제목/상태줄/안내줄 고정, 필드 영역만 스크롤 */
#main-panel.pinned { height: 1fr; }
#fields-slot { height: 1fr; }

.field-label {
    width: 1fr;
    height: 1;
    color: white;
}

.field-box {
    width: 1fr;
    height: 1;
    margin-bottom: 1;
    color: white;
    background: black;
}

.inline-row {
    width: 1fr;
    height: auto;
}

.inline-field {
    width: 1fr;
    height: auto;
}

.inline-row .inline-field:first-child { margin-right: 1; }

.run-row {
    width: 1fr;
    height: auto;
    align: center middle;
    margin: 1 0 0 0;
}

.run-row .field-box {
    width: 21;
    margin-bottom: 0;
}

/* ---------------- 상태줄 / 안내줄 ---------------- */
/* 상태줄: 이중선 줄 자체가 상태줄 ('═══ Ready ═════') */
#status-line {
    width: 1fr;
    height: 1;
    margin-top: 1;
    color: white;
}

#controls-line {
    width: 1fr;
    height: auto;
    margin-top: 1;
    padding-top: 0;
    color: white;
    border-top: double white;
}

/* 도구 화면: 이중선 자리는 상태줄이 대신하므로 안내줄 테두리를 없애고, 아래에 빈 줄 1칸을 둔다 */
#main-panel.pinned #controls-line {
    margin-top: 0;
    margin-bottom: 1;
    border-top: none;
}

/* ---------------- 홈: 도구 목록 ---------------- */
#tool-list {
    height: auto;
    max-height: 20;
    background: black;
    color: white;
    border: none;
    padding: 0;
}

/* 고정 레이아웃(홈): 목록이 제목~상태줄 사이 남는 공간을 모두 쓰고 넘치면 스크롤 */
#main-panel.pinned #tool-list {
    height: 1fr;
    max-height: 100%;
}

#tool-list > .option-list--option,
#tool-list > .option-list--option-hover {
    color: white;
    background: black;
}

/* 하이라이트 색은 필드 포커스(ui/fields/base.py 의 "black on white")와 같은 색 */
#tool-list > .option-list--option-highlighted,
#tool-list:focus > .option-list--option-highlighted {
    color: ansi_black;
    background: ansi_white;
    text-style: none;
}

#tool-list > .option-list--option-disabled { color: grey; }

/* ---------------- 모달 공통 ---------------- */
#log-box, #confirm-box {
    width: 64;
    height: auto;
    margin-top: 1;
    padding: 0 1;
    background: black;
    color: white;
    border: solid white;
}

#log-content { height: 16; color: white; }

#log-controls, #confirm-controls {
    width: 1fr;
    height: auto;
    margin-top: 1;
    color: white;
}

#confirm-message { width: 1fr; height: auto; color: white; }

/* 로그 화면: 안내줄은 박스(테두리) 밖, 바로 아래. 박스 안쪽 글자 위치(테두리1+패딩1)에 맞춘다 */
#log-controls {
    width: 64;
    margin-top: 0;
    padding: 0 2;
}
